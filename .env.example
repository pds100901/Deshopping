# Copia este archivo como .env (en esta misma carpeta) para que los agentes respondan con un modelo real.
# Sin clave, la oficina funciona igual con sus frases locales.

# Clave de la API de Anthropic: se crea en https://console.anthropic.com (API keys).
# Requiere saldo cargado en esa consola. NO es tu suscripción de Claude (Pro o Max): se cobra aparte.
# Se queda en tu equipo: solo la lee el servidor local, nunca llega al navegador.
ANTHROPIC_API_KEY=

# Modelo que responde. Cámbialo si tu cuenta usa otro id.
ANTHROPIC_MODEL=claude-haiku-5-5

# Tu nombre, para que los agentes te llamen así. Vacío: te hablan de vos, sin nombre.
TU_NOMBRE=Pau
